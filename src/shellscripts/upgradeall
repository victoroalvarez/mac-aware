#!/bin/bash
# Upgrade PKGSRC & Brew for macOS

# Upgrade PKGSRC
upgrade_pkgsrc() {
  printf '\nUpgrade PKGSRC:';
  sudo pkgin update && sudo pkgin upgrade;
}

# Upgrade Brew
upgrade_brew() {
 printf '\nUpgrade Brew:';
 brew update && brew upgrade;
}

# Run all upgrades
main() {
 upgrade_pkgsrc
 upgrade_brew
}

# Run main function
main
